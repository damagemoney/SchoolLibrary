@if (Errors.Count > 0)
{
    <div class="errors">
        <strong>Исправьте ошибки:</strong>
        <ul>
            @foreach (var error in Errors)
            {
                <li>@error</li>
            }
        </ul>
    </div>
}

@code {
    [Parameter]
    public List<string> Errors { get; set; } = new();
}
